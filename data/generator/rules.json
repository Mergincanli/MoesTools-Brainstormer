  "status": "draft",
  "defaults": {
    "spice": 2,
    "input_odds": {
      "tier": {
        "t1": 1,
        "t2": 1,
        "t3": 1
      },
      "flavour": {
        "soviet": 1,
        "allied": 1,
        "empire": 1
      }
    },
    "fill_pattern_requires": true,
    "spice_fallback": "least-rare",
    "avoided_blocks_implied": true,
    "default_rarity": "common",
    "handling": "default_handling",
    "weapon_default_weight": 3,
    "mount_uses_aim_rarity": true,
    "role_weight": 3,
    "pattern_roles_first": true,
    "take_what_fits": true,
    "favoured_step": 1,
    "flavour_lean": "favoured",
    "variant_odds": "equal",
    "always_variant": true,
    "kind_odds": "equal",
    "seats": {
      "operating": ["gunner", "commander"],
      "gunner": ["secondary-weapon"],
      "commander": ["last-extra", "signature"]
    },
    "implied_pattern_as_extra": true,
    "second_form": {
      "via": ["transform"],
      "uses_body_rule": false
    },
    "adaptive": {
      "slot": "primary",
      "slot_when_family_required": "secondary",
      "when_links": {
        "passenger-sets-weapon": "role",
        "leech-weapon-on-kill": "weapon"
      }
    },
    "same_mechanic_check": {
      "related": ["variant-of", "generalises"],
      "likeness": 0.5,
      "likeness_of": ["categories", "kinds", "classes", "implies", "requires", "countered_by", "counters", "hooks"],
      "shared_unit_entries": 2
    },
    "key_traits_only_when_implied": true,
    "primary_weapon_seat": {
      "full-control": "driver",
      "auto-gunner": "driver",
      "seat-swap": "gunner",
      "needs-crew": "gunner",
      "note": "Reading: section 7 says that with full control or an auto-gunner the buyer drives and fires the primary weapon, that with seat-swap the lone player switches between driving and shooting, and that with needs-crew the main gun needs a second player. The last two are read as the gunner seat firing the primary weapon, as the solo-fallback word list describes them."
    },
    "passengers": {
      "only_from_patterns": true,
      "caps": {
        "tiny": 0,
        "small": 1,
        "medium": 4,
        "large": 6,
        "huge": 8
      },
      "seat_odds": "equal",
      "kinds": [
        {
          "pattern": "passenger-sets-weapon",
          "variants": ["fire-ports"],
          "kind": "passenger-firing"
        },
        {
          "pattern": "passenger-sets-weapon",
          "kind": "passenger-module"
        },
        {
          "kind": "passenger-cargo"
        }
      ],
      "note": "Not in the sheet: seat_odds. Section 7 gives the range (from the needed minimum to the cap for the size) but no odds within it, so each number of seats in the range is equally likely."
    },
    "nature": [
      {
        "when": "body:beast",
        "nature": "organic"
      },
      {
        "when": "crew:remote",
        "nature": "uncrewed-machine"
      },
      {
        "when": "class:infantry",
        "nature": "organic"
      },
      {
        "when": "class:drone",
        "nature": "uncrewed-machine"
      },
      {
        "nature": "crewed-machine"
      }
    ],
    "on_death": {
      "who_gets_out": ["respawn", "bail-out", "pilot-eject"],
      "what_is_left": ["wreck", "death-blast"],
      "default": {
        "crewed-machine": "bail-out",
        "organic": "respawn",
        "uncrewed-machine": "respawn"
      },
      "default_weight": 3,
      "crewed_machine_only": ["bail-out", "pilot-eject"],
      "never_together": [["wreck", "respawn"]]
    },
    "unarmed": {
      "primary_roles": ["support", "transport", "infiltrator", "engineer", "logistics"],
      "signature_categories": ["support", "transport-garrison", "infiltration", "summon", "control"],
      "one_in": 3,
      "note": "Reading: the sheet says 'the role'; it is read as the primary role, the only role known when the weapons are rolled (step 13; secondary roles come at step 16)."
    },
    "secondary_weapon": {
      "always_with": "gunner",
      "one_in": 2
    },
    "resource": null,
    "set_unguaranteed_links": true,
    "pair_within_ability": true,
    "matchup_lists": {
      "lists": ["strengths", "weaknesses", "counters", "countered_by"],
      "max": 5,
      "signature_first": true,
      "note": "Reading: M4 sits under strengths and weaknesses, but it cites the field rules' Matchups rule 7, which covers counters and countered by as well, so all four lists are capped."
    },
    "counter_check": {
      "list": "countered_by",
      "drop_unsatisfiable": true
    },
    "derived_links": {
      "damage_vs": ["armour-class", "nature", "armour-model"],
      "flier_hits": {
        "low-air": "hits:low-air",
        "high-air": "hits:high-air"
      },
      "no_air_weapon": "class:aircraft",
      "drop_immune": true,
      "counters_from_damage": true
    }
