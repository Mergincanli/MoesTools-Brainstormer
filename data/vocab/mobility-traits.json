{
  "$schema": "../../schemas/vocabulary.schema.json",
  "id": "mobility-traits",
  "label": "Mobility traits",
  "description": "Extras on top of the base mobility; a card has up to two. Traits marked 'uses a key' are buttons: they count toward the tier's key budget and need their matching mechanic pattern.",
  "group": "supporting",
  "status": "draft",
  "version": "0.4.0",
  "terms": [
    {
      "id": "amphibious",
      "label": "Amphibious",
      "description": "Moves on water as well as land.",
      "classes": ["infantry", "vehicle", "walker", "drone"],
      "rarity": "uncommon",
      "uses_key": false,
      "excluded": {
        "mobility": ["rotor", "jet", "airship", "jetpack", "hover"]
      }
    },
    {
      "id": "climb",
      "label": "Climb",
      "description": "Climbs walls and cliffs.",
      "classes": ["infantry", "walker", "drone"],
      "rarity": "uncommon",
      "uses_key": false,
      "allowed": {
        "mobility": ["foot", "legs-multi"]
      }
    },
    {
      "id": "crush",
      "label": "Crush",
      "description": "Runs over smaller units in its path: infantry and small drones; super-heavies also crush light vehicles.",
      "classes": ["vehicle", "walker", "hover"],
      "rarity": "common",
      "uses_key": false,
      "allowed": {
        "sizes": ["large", "huge"]
      }
    },
    {
      "id": "leap",
      "label": "Leap",
      "description": "Jumps over walls or gaps.",
      "classes": ["infantry", "vehicle", "walker", "drone"],
      "class_rarity": {
        "vehicle": "rare"
      },
      "rarity": "uncommon",
      "uses_key": true,
      "pattern": "leap",
      "excluded": {
        "mobility": ["rotor", "jet", "airship", "jetpack", "hover"]
      }
    },
    {
      "id": "boost",
      "label": "Boost",
      "description": "A short burst of speed or a dash.",
      "classes": ["infantry", "vehicle", "walker", "hover", "aircraft", "drone"],
      "rarity": "common",
      "uses_key": true,
      "pattern": "dash"
    },
    {
      "id": "burrow",
      "label": "Burrow / submerge",
      "description": "Goes underground or underwater to hide or travel; must surface to act.",
      "classes": ["infantry", "vehicle", "walker", "hover", "drone"],
      "class_rarity": {
        "hover": "rare"
      },
      "rarity": "rare",
      "uses_key": true,
      "pattern": "burrow",
      "excluded": {
        "mobility": ["rotor", "jet", "airship", "jetpack"]
      }
    },
    {
      "id": "teleport",
      "label": "Teleport",
      "description": "Blinks a short distance or jumps through space.",
      "classes": ["infantry", "vehicle", "walker", "hover", "aircraft", "drone"],
      "class_rarity": {
        "aircraft": "rare"
      },
      "rarity": "rare",
      "uses_key": true,
      "pattern": "teleport"
    },
    {
      "id": "transform",
      "label": "Transform",
      "description": "Switches between two forms, such as walker and jet; the unit records the second form in its modes.",
      "classes": ["infantry", "vehicle", "walker", "hover", "aircraft", "drone"],
      "class_rarity": {
        "infantry": "rare",
        "drone": "rare"
      },
      "rarity": "rare",
      "uses_key": true,
      "pattern": "transform"
    },
    {
      "id": "deploy-anchor",
      "label": "Deploy / anchor",
      "description": "Stops to enter a stronger stationary mode; must pack up to move.",
      "classes": ["infantry", "vehicle", "walker", "hover", "aircraft", "drone"],
      "class_rarity": {
        "aircraft": "rare",
        "drone": "uncommon"
      },
      "rarity": "uncommon",
      "uses_key": true,
      "pattern": "deploy-siege-mode"
    }
  ]
}
