{
  "$schema": "../../schemas/vocabulary.schema.json",
  "id": "faction-flavours",
  "label": "Faction flavours",
  "description": "Generic faction identities in Red Alert 3's spirit. A flavour makes its favoured parts three times as likely and one step more common for that faction (rare counts as uncommon, uncommon as common), so a grounded Soviet card can roll tesla weapons and an Allied card at spice 2 can roll prism. The step never applies to a class rarity, so a favoured cross-over (a flamethrower on a Soviet aircraft) still waits for high spice. It holds back its avoided parts until spice 3.",
  "group": "core",
  "status": "approved",
  "version": "1.0.0",
  "terms": [
    {
      "id": "soviet",
      "label": "Soviets",
      "description": "Heavy, brute force, electric weapons.",
      "themes": [
        "mass and armour",
        "tesla and electric weapons",
        "magnetism",
        "industrial salvage and recycling",
        "cheap numbers and crude reliability",
        "big walkers and airships"
      ],
      "favoured": {
        "weapon-families": ["tesla", "cannon", "flak", "flamethrower", "machine-gun", "magnetic", "drain"],
        "damage-types": ["electric", "armour-piercing", "explosive", "fire"],
        "mobility": ["tracks", "legs-biped", "legs-multi", "airship"],
        "mobility-traits": ["crush", "leap", "amphibious"],
        "bodies": ["hull-turret", "multi-turret", "chicken-walker", "envelope", "spider-frame"],
        "sizes": ["large", "huge"],
        "speed-bands": ["slow", "medium"],
        "armour-classes": ["heavy", "super-heavy"],
        "armour-models": ["damage-reduction", "ablative-plates", "directional"],
        "crew-models": ["driver-gunner", "driver-gunner-commander"],
        "aim-models": ["slow-turret", "free-aim"],
        "roles": ["assault", "anti-armour", "siege"],
        "team-play-hooks": ["protector", "escort-dependency", "swarm"]
