{
  "$schema": "../../schemas/vocabulary.schema.json",
  "id": "bodies",
  "label": "Body plans",
  "description": "The unit's upper-body shape and silhouette (legs and wheels live in mobility, scale in size). Each body lists the mobility types and sizes it fits and how its weapons can be mounted. A transforming unit records its second form's body in its modes.",
  "group": "core",
  "status": "draft",
  "version": "0.4.0",
  "terms": [
    {
      "id": "humanoid",
      "label": "Humanoid",
      "description": "A soldier or hero on two feet.",
      "classes": ["infantry"],
      "rarity": "common",
      "allowed": {
        "mobility": ["foot", "jetpack"],
        "sizes": ["small"],
        "aim-models": ["free-aim", "body-aim", "radial"]
      }
    },
    {
      "id": "power-suit",
      "label": "Power suit",
      "description": "An armoured exosuit, bigger than a soldier. At small size it is infantry; at medium size or bigger it is a walker.",
      "classes": ["infantry", "walker"],
      "rarity": "uncommon",
      "allowed": {
        "mobility": ["foot", "jetpack", "legs-biped"],
        "sizes": ["small", "medium"]
      }
    },
    {
      "id": "beast",
