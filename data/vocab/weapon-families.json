{
  "$schema": "../../schemas/vocabulary.schema.json",
  "id": "weapon-families",
  "label": "Weapon families",
  "description": "What the weapon is, judged by how it behaves in the source, not by its name. Each family has defaults (damage, mount, delivery, range) and lists what it may be combined with. Tie-breaks: a missile that steers is guided, an unguided one is a rocket; a soldier's personal gun is small arms, a belt-fed or mounted gun is a machine gun; prism only if the beam splits, travelling bolts are plasma; placed or thrown charges are explosives, dropped ones are bombs; artillery only for arcing or out-of-sight fire.",
  "group": "core",
  "status": "draft",
  "version": "0.4.0",
