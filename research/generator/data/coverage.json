{
  "about": "Every rule code of sections 2 to 11 of docs/generator-rules.md, plus the uncoded rows of its tables, and where each is in the generator files. in = the sheet's own In marker (R rules.json, N names.json, X texts.json, WL word lists, PG patterns, V validator, P3 rolled-card checker, code the generator's code). where = JSON pointers into the files (rules.json, names.json, texts.json, generator.schema.json); the schema's description of each place states the rule. not_data = the rule lives elsewhere, and where. note = what the files do not hold, or a reading.",
  "codes": {
    "G1": { "in": "WL", "not_data": "Word lists: source_only, classes, min_tier, allowed and excluded (both ways); the validator checks them on cards." },
    "G2": { "in": "WL", "not_data": "Word lists' requires groups; the validator checks them on cards." },
    "G3": { "in": "PG", "not_data": "The patterns' implies; the generator's code sets them first." },
    "G4": { "in": "R", "where": ["rules.json#/defaults/fill_pattern_requires"] },
    "G5": { "in": "R", "where": ["rules.json#/defaults/spice_fallback"] },
    "G6": { "in": "R", "where": ["rules.json#/defaults/avoided_blocks_implied"] },
    "G7": { "in": "R", "where": ["rules.json#/attempts"], "note": "The sheet's 'stream = seed + step + attempt' is read as one stream per field (section 2 and section 16 say per field, not per step); the stream itself is code." },
    "G8": { "in": "code", "not_data": "The card records its data version (card schema); the generator's code. The version of each generator file feeds it: rules.json#/version." },
    "G9": { "in": "R", "where": ["rules.json#/defaults/default_rarity"] },
    "G10": { "in": "R", "where": ["rules.json#/defaults/handling"] },
    "G11": { "in": "WL, PG", "not_data": "The family's default_range (word list) and the patterns' implies and requires." },
    "G12": { "in": "WL, R", "where": ["rules.json#/defaults/weapon_default_weight", "rules.json#/defaults/mount_uses_aim_rarity"] },
    "G13": { "in": "R", "where": ["rules.json#/role_fit", "rules.json#/defaults/role_weight"] },
    "G14": { "in": "R", "where": ["rules.json#/counts/secondary_roles", "rules.json#/defaults/pattern_roles_first", "rules.json#/defaults/default_rarity", "rules.json#/defaults/spice_fallback"] },
    "G15": { "in": "none", "not_data": "Word-list fields the generator does not read; nothing to store." },
    "G16": { "in": "R", "where": ["rules.json#/defaults/take_what_fits"] },
    "S1": { "in": "WL", "not_data": "Rarity weights and favoured_weight in the word lists." },
    "S2": { "in": "R", "where": ["rules.json#/defaults/favoured_step"] },
    "S3": { "in": "WL, PG", "not_data": "class_rarity in the word lists and the patterns." },
    "S4": { "in": "WL", "not_data": "avoided and avoided_until_spice in faction-flavours; the off-flavour flag is in balance-flags." },
    "S5": { "in": "R", "where": ["rules.json#/defaults/flavour_lean"] },
    "S6": { "in": "R", "where": ["rules.json#/defaults/variant_odds"] },
    "A1": { "in": "PG, R", "where": ["rules.json#/defaults/role_weight"] },
    "A2": { "in": "R", "where": ["rules.json#/defaults/always_variant"] },
    "A3": { "in": "R", "where": ["rules.json#/defaults/kind_odds", "rules.json#/hard_control/classes/stun/key_kinds_only"] },
    "A4": { "in": "R", "where": ["rules.json#/cooldowns", "rules.json#/cooldowns/hard_control", "rules.json#/cooldowns/hard_control_ultimate"], "note": "The medium:long weights of the hard-control override are not in the sheet (1:1 chosen)." },
    "A5": { "in": "R", "where": ["rules.json#/defaults/seats"] },
    "A6": { "in": "R", "where": ["rules.json#/counts/abilities"] },
    "A7": { "in": "PG", "not_data": "The patterns' generator fields, read as they are." },
    "A8": { "in": "R", "where": ["rules.json#/defaults/implied_pattern_as_extra"] },
    "A9": { "in": "R", "where": ["rules.json#/defaults/second_form", "rules.json#/counts/second_form_weapons"], "note": "The odds of 0 or 1 weapon are not in the sheet (1:1 chosen)." },
    "A10": { "in": "R", "where": ["rules.json#/defaults/adaptive", "rules.json#/counts/conditional_weapons"], "note": "The odds of 2, 3 or 4 conditional weapons are not in the sheet (equal chosen)." },
    "A11": { "in": "R", "where": ["rules.json#/same_mechanic", "rules.json#/defaults/same_mechanic_check"] },
    "K-a": { "in": "WL, V", "not_data": "uses_key in ability-kinds and mobility-traits; the validator counts keys." },
    "K-b": { "in": "WL", "not_data": "The tiers word list's description." },
    "K-c": { "in": "WL", "not_data": "tiers.max_keys_per_seat; the seat-overloaded flag." },
    "K-d": { "in": "WL, R", "where": ["rules.json#/defaults/key_traits_only_when_implied"] },
    "K-e": { "in": "none", "not_data": "The K1 conflict; Mustafa answered K1 A, which changes the validator's key count (P2)." },
    "K-f": { "in": "R", "where": ["rules.json#/layout", "texts.json#/templates/controls"], "note": "Left out: 'A signature that is the primary weapon may sit on LMB.' A card cannot say that its signature is its primary weapon until the card property of answer K2 A is approved, so the files hold nothing about K2." },
    "K-g": { "in": "code", "not_data": "balance.keys is computed by the generator's code." },
    "HC1": { "in": "R", "where": ["rules.json#/hard_control/entries/0"] },
    "HC2": { "in": "R", "where": ["rules.json#/hard_control/classes/stun/min_tier", "rules.json#/hard_control/entries/10/min_tier", "rules.json#/hard_control/entries/11/min_tier", "rules.json#/hard_control/entries/12/min_tier"] },
    "HC3": { "in": "R, P3", "where": ["rules.json#/hard_control/classes/stun/key_kinds_only", "rules.json#/cooldowns/hard_control", "rules.json#/cooldowns/hard_control_ultimate"] },
    "HC4": { "in": "R, X", "where": ["rules.json#/hard_control/entries", "rules.json#/hard_control/entries/1/escape_line", "texts.json#/escapes/latch", "texts.json#/templates/as_target"] },
    "HC5": { "in": "none", "not_data": "'Kept short' is stated by each variant's own text; not checked in step 3b." },
    "HC6": { "in": "R", "where": ["rules.json#/hard_control/classes/latch/min_tier"] },
    "HC7": { "in": "R, X", "where": ["rules.json#/hard_control/weapon_families", "rules.json#/hard_control/weapon_families/note", "texts.json#/escapes/cryo", "texts.json#/escapes/emp", "texts.json#/escapes/psionic", "texts.json#/escapes/magnetic"] },
    "C1": { "in": "R", "where": ["rules.json#/counts/mobility_traits", "rules.json#/counts/armour_models", "rules.json#/counts/weapon_traits"] },
    "C2": { "in": "V", "not_data": "The validator: a multi-seat crew needs a solo fallback." },
    "C3": { "in": "R", "where": ["rules.json#/defaults/on_death", "rules.json#/counts/on_death"] },
    "C4": { "in": "R, P3", "where": ["rules.json#/defaults/seats/operating"] },
    "M1": { "in": "PG", "not_data": "adds_strengths and adds_weaknesses of the patterns and variants; parts add none in step 3b." },
    "M2": { "in": "R", "where": ["rules.json#/defaults/set_unguaranteed_links"] },
    "M3": { "in": "R, V, P3", "where": ["rules.json#/defaults/pair_within_ability"] },
    "M4": { "in": "R", "where": ["rules.json#/defaults/matchup_lists"] },
    "N1": { "in": "V", "not_data": "The validator's matches function." },
    "N2": { "in": "R, P3", "where": ["rules.json#/defaults/counter_check"] },
    "N3": { "in": "code", "not_data": "Worked out once per data version from the hard rules (counters.mjs)." },
    "N4": { "in": "R", "where": ["rules.json#/defaults/derived_links", "texts.json#/derived_reasons"] },
    "B1": { "in": "R", "where": ["rules.json#/points/power", "rules.json#/points/pattern", "rules.json#/points/parts"] },
    "B2": { "in": "R", "where": ["rules.json#/points/complexity", "rules.json#/points/parts/passenger_seats", "rules.json#/defaults/seats/operating"] },
    "B3": { "in": "R", "where": ["rules.json#/points/cost_bands", "rules.json#/points/tier_bands", "rules.json#/points/parts"] },
    "T-a": { "in": "N, V, P3", "where": ["names.json#/soviet/words", "names.json#/allied/words", "names.json#/empire/words", "names.json#/signature_nouns"], "note": "The check itself is code (names.mjs, the validator, the rolled-card checker); the files hold the banks after the 15 dropped entries." },
    "T-b": { "in": "X, code, P3", "where": ["texts.json#/neutral"], "note": "The check itself is code; the files hold the neutral sentences." },
    "1 class": { "in": "WL", "not_data": "Rolled by the classes list's rarity." },
    "1 tier": { "in": "R", "where": ["rules.json#/defaults/input_odds/tier"] },
    "1 flavour": { "in": "R", "where": ["rules.json#/defaults/input_odds/flavour"] },
    "1 role": { "in": "WL, R", "where": ["rules.json#/roll_order/2", "rules.json#/defaults/pattern_roles_first"] },
    "1 spice": { "in": "R", "where": ["rules.json#/defaults/spice"] },
    "1 seed": { "in": "code", "not_data": "The command makes and stores it." },
    "1 locks": { "in": "code", "not_data": "The card schema's lockable parts." },
    "I1": { "in": "code", "not_data": "The generator's code." },
    "I2": { "in": "code", "not_data": "The generator's code." },
    "2 roll order": { "in": "R (P1)", "where": ["rules.json#/roll_order"] },
    "2 dice per field": { "in": "code", "not_data": "One dice stream per card field (seed and field name); described at generator.schema.json#/$defs/rules/properties/roll_order." },
    "3 rarity table": { "in": "WL", "not_data": "The rarity word list's min_spice and weights." },
    "5 key budget table": { "in": "WL", "not_data": "The tiers word list." },
    "6 hard-control list": { "in": "R", "where": ["rules.json#/hard_control/entries", "rules.json#/hard_control/classes"] },
    "6 (avoid) marks": { "in": "R", "where": ["rules.json#/hard_control/entries/10/escape_avoids", "rules.json#/hard_control/entries/11/escape_avoids", "rules.json#/hard_control/entries/13/escape_avoids", "rules.json#/hard_control/entries/15/escape_avoids", "rules.json#/hard_control/entries/16/escape_avoids", "rules.json#/hard_control/entries/17/escape_avoids", "rules.json#/hard_control/entries/18/escape_avoids"] },
    "6 borderline marks": { "in": "R", "where": ["rules.json#/hard_control/entries/13/borderline", "rules.json#/hard_control/entries/14/borderline", "rules.json#/hard_control/entries/15/borderline", "rules.json#/hard_control/entries/16/borderline"], "note": "The sheet's table marks these four; hard-control.json also marks become-invulnerable lock-and-pulse and retaliate-on-hit reflect-window, which the table describes as abilities that stun attackers." },
    "6 exception to 5B": { "in": "R", "where": ["rules.json#/hard_control/weapon_families/note"] },
    "7 crew model": { "in": "WL", "not_data": "crew-models term rules." },
    "7 solo fallback": { "in": "WL", "not_data": "solo-fallback rarities; the validator checks a fallback only on multi-seat crews." },
    "7 who does what": { "in": "R", "where": ["rules.json#/defaults/primary_weapon_seat", "rules.json#/defaults/seats"] },
    "7 passengers": { "in": "R", "where": ["rules.json#/defaults/passengers"], "note": "The odds of the seat count between the minimum and the cap are not in the sheet (equal chosen)." },
    "7 body count": { "in": "R", "where": ["rules.json#/counts/body_count"] },
    "7 nature": { "in": "R", "where": ["rules.json#/defaults/nature"] },
    "7 availability": { "in": "R", "where": ["rules.json#/counts/availability"] },
    "7 on death": { "in": "R", "where": ["rules.json#/defaults/on_death", "rules.json#/counts/on_death"] },
    "7 sight": { "in": "R", "where": ["rules.json#/counts/sight", "rules.json#/counts/sight_boost"] },
    "7 sensor traits": { "in": "WL, R", "where": ["rules.json#/counts/sensor_traits"] },
    "7 air layer": { "in": "WL", "not_data": "The mobility's target_type." },
    "7 unarmed": { "in": "R", "where": ["rules.json#/defaults/unarmed"] },
    "7 secondary weapon": { "in": "R", "where": ["rules.json#/defaults/secondary_weapon"] },
    "7 resource": { "in": "R", "where": ["rules.json#/defaults/resource"] },
    "9 link-kind table": { "in": "none", "not_data": "Counts for information (link-kinds.mjs)." },
    "10 pattern points": { "in": "R", "where": ["rules.json#/points/pattern"] },
    "10 ultimate": { "in": "R", "where": ["rules.json#/points/pattern/ultimate_bonus", "rules.json#/points/pattern/max"] },
    "10 part points": { "in": "R", "where": ["rules.json#/points/parts"] },
    "10 flag table": { "in": "P3", "not_data": "Severities are in balance-flags; when each fires is the rolled-card checker's job." },
    "11 name": { "in": "N", "where": ["names.json#/soviet/templates", "names.json#/allied/templates", "names.json#/empire/templates", "texts.json#/templates/name"] },
    "11 pitch": { "in": "X, N", "where": ["texts.json#/templates/pitch", "names.json#/soviet/flavour_word", "names.json#/soviet/class_nouns", "names.json#/allied/flavour_word", "names.json#/allied/class_nouns", "names.json#/empire/flavour_word", "names.json#/empire/class_nouns"] },
    "11 signature name": { "in": "X, N", "where": ["texts.json#/templates/signature_name", "names.json#/signature_nouns", "names.json#/soviet/signature_words", "names.json#/allied/signature_words", "names.json#/empire/signature_words"] },
    "11 signature effect": { "in": "X", "where": ["texts.json#/templates/signature_effect"] },
    "11 team-play hook": { "in": "X", "where": ["texts.json#/templates/team_play_hook"] },
    "11 as user": { "in": "X", "where": ["texts.json#/templates/as_user"] },
    "11 as target": { "in": "X", "where": ["texts.json#/templates/as_target"] },
    "11 teammates, tells": { "in": "X", "where": ["texts.json#/templates/teammates", "texts.json#/templates/tells"] },
    "11 controls": { "in": "X", "where": ["texts.json#/templates/controls", "rules.json#/layout"], "note": "The action wording is not in the sheet (the part's plain name chosen)." },
    "11 matchup reasons": { "in": "X", "where": ["texts.json#/templates/matchup_reasons", "texts.json#/derived_reasons"] },
    "11 counterplay": { "in": "X", "where": ["texts.json#/templates/counterplay"] },
    "11 inspiration": { "in": "X", "where": ["texts.json#/templates/inspiration"] },
    "11 word banks": { "in": "N", "where": ["names.json#/soviet/words", "names.json#/allied/words", "names.json#/empire/words"] },
    "11 signature nouns": { "in": "N", "where": ["names.json#/signature_nouns"] },
    "13 P1": { "in": "R, N, X", "where": ["generator.schema.json#/$defs/rules", "generator.schema.json#/$defs/names", "generator.schema.json#/$defs/texts"] },
    "15 K2": { "in": "none", "not_data": "Left out as instructed: answer K2 A waits for the primary_fire card property, which is not approved yet." }
  }
}
