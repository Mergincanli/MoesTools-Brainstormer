{
  "name": "unit-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Research database and (later) generator of original unit concepts for Shamble Frontlines.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "format": "node scripts/format-json.mjs",
    "format:check": "node scripts/format-json.mjs --check",
    "docs": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "test": "node --test",
    "copy-check": "node scripts/copy-check.mjs",
    "plant-test": "node scripts/plant.mjs",
    "page-text": "node scripts/page-text.mjs",
    "sample": "node scripts/sample-for-check.mjs",
    "agreement": "node scripts/agreement.mjs",
    "vocab-diff": "node scripts/vocab-diff.mjs",
    "sync-patterns": "node scripts/sync-patterns.mjs",
    "sync-patterns:check": "node scripts/sync-patterns.mjs --check",
    "check:generator": "node scripts/check-generator-data.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "manifest": "node scripts/build-manifest.mjs",
    "manifest:check": "node scripts/build-manifest.mjs --check",
    "roll": "node scripts/roll.mjs",
    "cross-check": "node scripts/cross-check.mjs",
    "cards": "node scripts/build-cards.mjs",
    "cards:check": "node scripts/build-cards.mjs --check",
    "check": "npm run format:check && npm run validate && npm run check:generator && npm run manifest:check && npm run cards:check && npm run docs:check && npm run typecheck && npm test",
    "check:merge": "npm run sync-patterns:check && npm run check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
