{
  "name": "unit-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Research database and (later) generator of original unit concepts for Shamble Frontlines.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "format": "node scripts/format-json.mjs",
    "format:check": "node scripts/format-json.mjs --check",
    "docs": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "test": "node --test",
    "copy-check": "node scripts/copy-check.mjs",
    "sample": "node scripts/sample-for-check.mjs",
    "agreement": "node scripts/agreement.mjs",
    "vocab-diff": "node scripts/vocab-diff.mjs",
    "check": "npm run format:check && npm run validate && npm run docs:check && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
