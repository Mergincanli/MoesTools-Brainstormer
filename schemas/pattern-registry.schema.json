{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pattern-registry.schema.json",
  "title": "Pattern registry",
  "description": "data/pattern-registry.json: the shared list of pattern ids, so every research agent uses the same names. A pattern is 'planned' until its file exists in data/patterns/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patterns"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "summary"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "x-vocab": "pattern-categories"
          },
          "summary": {
            "type": "string"
          },
          "from_brief": {
            "description": "True if the brief names it as an example.",
            "type": "boolean"
          }
        }
      }
    }
  }
}
